#!/bin/bash

# Uninstall the focus-gate CLI plumbing.
#
#   omarchy-focus-gate-uninstall
#
# Idempotent. Removes the bin symlinks pointing into this plugin. 
# It deliberately leaves:
#   ~/.config/omarchy-focus-gate/config.json
#   ~/.local/state/omarchy/focus-gate/state.json
# behind: that is your data. Delete those directories yourself when you
# really want a clean slate.

set -euo pipefail

FG_LIB="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/lib" && pwd)/common.sh"
# shellcheck source=lib/common.sh
source "$FG_LIB"

BIN_DIR="${XDG_BIN_HOME:-$HOME/.local/bin}"

fg_remove_bin_symlinks() {
  local link
  local resolved
  for link in "$BIN_DIR"/omarchy-focus-gate-*; do
    [[ -L $link ]] || continue
    resolved=$(readlink -f "$link" 2>/dev/null || true)
    if [[ $resolved == "$FG_PLUGIN_DIR"/bin/omarchy-focus-gate-* ]]; then
      rm -f "$link"
      echo "removed $link"
    fi
  done
}

fg_uninstall() {
  # Clean up old systemd units if they exist from the old version
  systemctl --user disable --now omarchy-focus-gate.timer 2>/dev/null || true
  rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/omarchy-focus-gate.timer" "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/omarchy-focus-gate.service" 2>/dev/null || true
  systemctl --user daemon-reload 2>/dev/null || true

  fg_remove_bin_symlinks
  echo
  echo "Focus Gate uninstalled. Kept: $FG_CONFIG_FILE and $FG_STATE_FILE."
  echo "To remove the plugin: omarchy plugin disable omarchy-focus-gate"
}

fg_uninstall "$@"